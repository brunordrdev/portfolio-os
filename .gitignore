# Preferências locais da ferramenta, específicas desta máquina.
# O CLAUDE.md, esse sim, é regra do repositório e vai versionado.
.claude/settings.local.json

# O passo de deploy instala o wrangler com npm na raiz do repositório, e
# isso deixa node_modules/ e os dois arquivos de pacote para trás. Este é
# um projeto Flutter: qualquer coisa de Node aqui é resíduo do CI, não
# código. Sem estas linhas o wrangler enxerga a árvore suja e avisa que
# está publicando um commit com alterações não commitadas.
node_modules/
package.json
package-lock.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
